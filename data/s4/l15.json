    {
     "hangul": "저는 학생이에요",
     "meaning": {
      "de": "Ich bin Student(in).",
      "en": "I'm a student."
     }
    },
    {
     "hangul": "네, 맛있어요",
     "meaning": {
      "de": "Ja, es ist lecker.",
      "en": "Yes, it's tasty."
     }
    }
   ],
