   "id": "s4-d-sub-where-going",
   "hangul": "어디에 가요?",
   "type": "dialog",
   "topic": "subway",
   "sound": {
    "de": "eodie gayo?",
    "en": "eodie gayo?"
   },
   "meaning": {
    "de": "Wohin fahren Sie?",
    "en": "Where are you going?"
   },
   "reply": {
    "hangul": "명동에 가요",
    "sound": {
     "de": "myeongdonge gayo",
     "en": "myeongdonge gayo"
    },
    "meaning": {
     "de": "Ich fahre nach Myeongdong.",
     "en": "I'm going to Myeongdong."
    }
   },
   "wrongReplies": [
