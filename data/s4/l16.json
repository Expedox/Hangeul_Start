 "title": {
  "de": "Gespräch: im Hotel",
  "en": "Conversation: at the hotel"
 },
 "intro": {
  "de": "An der Rezeption spricht man dich sehr höflich an, oft mit -세요 oder -으세요.\n성함 ist das höfliche Wort für „Name“. Du antwortest normal mit -요.",
  "en": "At reception, staff address you very politely, often with -세요 or -으세요.\n성함 is the honorific word for \"name\". You simply answer with -요."
 },
 "exercises": [
  "dialog-reply"
 ],
 "check": {
  "questions": 8
 },
 "items": [
  {
   "id": "s4-d-hotel-reservation",
   "hangul": "어서 오세요. 예약 있으세요?",
   "type": "dialog",
   "topic": "hotel",
   "sound": {
    "de": "eoseo oseyo. yeyak isseuseyo?",
    "en": "eoseo oseyo. yeyak isseuseyo?"
   },
   "meaning": {
    "de": "Willkommen. Haben Sie reserviert?",
    "en": "Welcome. Do you have a reservation?"
   },
   "reply": {
    "hangul": "네, 예약이 있어요",
    "sound": {
     "de": "ne, yeyagi isseoyo",
     "en": "ne, yeyagi isseoyo"
    },
    "meaning": {
     "de": "Ja, ich habe eine Reservierung.",
     "en": "Yes, I have a reservation."
    }
   },
   "wrongReplies": [
    {
     "hangul": "네, 날씨가 좋아요",
     "meaning": {
      "de": "Ja, das Wetter ist schön.",
      "en": "Yes, the weather is nice."
     }
    },
    {
     "hangul": "아니요, 안 매워요",
     "meaning": {
      "de": "Nein, es ist nicht scharf.",
      "en": "No, it's not spicy."
     }
    },
    {
     "hangul": "저는 영화를 봐요",
     "meaning": {
      "de": "Ich sehe einen Film.",
      "en": "I'm watching a movie."
     }
    }
   ],
   "note": {
    "de": "있으세요 ist die ehrende Form von 있어요.",
    "en": "있으세요 is the honorific form of 있어요."
   },
   "audio": "audio/s4-d-hotel-reservation.mp3"
  },
  {
   "id": "s4-d-hotel-name",
   "hangul": "성함이 어떻게 되세요?",
   "type": "dialog",
   "topic": "hotel",
   "sound": {
    "de": "seonghami eotteoke doeseyo?",
    "en": "seonghami eotteoke doeseyo?"
   },
   "meaning": {
    "de": "Wie ist Ihr Name, bitte?",
    "en": "May I have your name?"
   },
   "reply": {
    "hangul": "제 이름은 안나 슈미트예요",
    "sound": {
     "de": "je ireumeun anna syumiteuyeyo",
     "en": "je ireumeun anna syumiteuyeyo"
    },
    "meaning": {
     "de": "Mein Name ist Anna Schmidt.",
     "en": "My name is Anna Schmidt."
    }
   },
   "wrongReplies": [
    {
     "hangul": "방이 커요",
     "meaning": {
      "de": "Das Zimmer ist groß.",
      "en": "The room is big."
     }
    },
    {
     "hangul": "호텔에 가요",
     "meaning": {
      "de": "Ich gehe zum Hotel.",
      "en": "I'm going to the hotel."
     }
    },
    {
     "hangul": "저는 피곤해요",
     "meaning": {
      "de": "Ich bin müde.",
      "en": "I'm tired."
     }
    }
   ],
   "note": {
    "de": "Höfliche Frage nach dem Namen. Wörtlich: „Wie wird Ihr Name?“",
    "en": "A polite way to ask for a name. Literally: \"How does your name become?\""
   },
   "audio": "audio/s4-d-hotel-name.mp3"
  },
  {
   "id": "s4-d-hotel-passport",
   "hangul": "여권 주세요",
   "type": "dialog",
   "topic": "hotel",
   "sound": {
    "de": "yeogwon juseyo",
    "en": "yeogwon juseyo"
   },
   "meaning": {
    "de": "Ihren Pass, bitte.",
    "en": "Your passport, please."
   },
   "reply": {
    "hangul": "네, 여기 있어요",
    "sound": {
     "de": "ne, yeogi isseoyo",
     "en": "ne, yeogi isseoyo"
    },
    "meaning": {
     "de": "Ja, hier ist er.",
     "en": "Sure, here it is."
    }
   },
   "wrongReplies": [
    {
     "hangul": "저는 수영해요",
     "meaning": {
      "de": "Ich schwimme.",
      "en": "I swim."
     }
    },
    {
     "hangul": "네, 비싸요",
     "meaning": {
      "de": "Ja, es ist teuer.",
      "en": "Yes, it's expensive."
     }
    },
    {
     "hangul": "공원에서 놀아요",
     "meaning": {
      "de": "Ich spiele im Park.",
      "en": "I'm playing in the park."
     }
    }
   ],
   "note": {
    "de": "여기 있어요 sagst du immer, wenn du etwas überreichst.",
    "en": "Say 여기 있어요 whenever you hand something over."
   },
   "audio": "audio/s4-d-hotel-passport.mp3"
  },
