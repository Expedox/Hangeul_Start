 "title": {
  "de": "Restaurant",
  "en": "Restaurant"
 },
 "intro": {
  "de": "Im Restaurant kommt alles mit 주세요 („bitte geben Sie mir“): 메뉴 주세요, 물 주세요.\nBeilagen (반찬) gibt es meist kostenlos und auch zum Nachfüllen. Bezahlt wird oft vorne an der Kasse.",
  "en": "In a restaurant, everything goes with 주세요 (\"please give me\"): 메뉴 주세요, 물 주세요.\nSide dishes (반찬) are usually free, with refills. You often pay at the counter by the door."
 },
 "exercises": [
  "see-meaning",
  "pick-hangul",
  "hear-meaning",
  "build-sentence"
 ],
