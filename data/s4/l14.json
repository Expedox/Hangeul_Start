{
 "id": "s4-l14",
 "stage": 4,
 "lesson": 14,
 "title": {
  "de": "Notfall",
  "en": "Emergency"
 },
 "intro": {
  "de": "In Korea erreichst du die Polizei unter 112 und Feuerwehr und Rettungsdienst unter 119.\nIm Notfall reichen kurze Sätze: 도와주세요! = Hilfe! Laut und deutlich sprechen ist wichtiger als perfekte Grammatik.",
  "en": "In Korea, police is 112, and fire and ambulance is 119.\nIn an emergency, short sentences are enough: 도와주세요! = Help! Speaking loud and clear matters more than perfect grammar."
 },
 "exercises": [
  "see-meaning",
  "pick-hangul",
  "hear-meaning",
  "build-sentence"
 ],
 "check": {
  "questions": 8
 },
