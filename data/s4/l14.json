   "type": "phrase",
   "topic": "emergency",
   "sound": {
    "de": "dowajuseyo",
    "en": "dowajuseyo"
   },
   "meaning": {
    "de": "Hilfe! / Bitte helfen Sie mir.",
    "en": "Help! / Please help me."
   },
   "mnemonic": {
    "de": "Laut gerufen: „Do-wa!“ – jemand soll kommen.",
    "en": "Shouted out loud: \"Doh-wah!\" – someone come."
   },
   "note": {
    "de": "Grundform 도와주다. -세요 ist eine höfliche Bitte.",
    "en": "Dictionary form 도와주다. -세요 makes it a polite request."
   },
