   "sound": {
    "de": "mwo chajeuseyo?",
    "en": "mwo chajeuseyo?"
   },
   "meaning": {
    "de": "Suchen Sie etwas Bestimmtes?",
    "en": "Are you looking for something?"
   },
   "reply": {
