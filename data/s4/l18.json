  {
   "id": "s4-d-shop-price",
   "hangul": "이 가방은 오만 원이에요",
   "type": "dialog",
   "topic": "shopping",
   "sound": {
    "de": "i gabangeun oman wonieyo",
    "en": "i gabangeun oman wonieyo"
   },
   "meaning": {
    "de": "Diese Tasche kostet 50.000 Won.",
    "en": "This bag is 50,000 won."
   },
   "reply": {
    "hangul": "너무 비싸요. 깎아 주세요",
    "sound": {
     "de": "neomu bissayo. kkakka juseyo",
     "en": "neomu bissayo. kkakka juseyo"
    },
    "meaning": {
     "de": "Zu teuer. Bitte etwas billiger.",
     "en": "Too expensive. Can you go lower?"
    }
   },
   "wrongReplies": [
    {
     "hangul": "네, 날씨가 좋아요",
     "meaning": {
      "de": "Ja, das Wetter ist schön.",
      "en": "Yes, the weather is nice."
     }
    },
    {
     "hangul": "도서관에서 공부해요",
     "meaning": {
      "de": "Ich lerne in der Bibliothek.",
      "en": "I study at the library."
     }
    },
    {
     "hangul": "아이가 자요",
     "meaning": {
      "de": "Das Kind schläft.",
      "en": "The child is sleeping."
     }
    }
   ],
   "audio": "audio/s4-d-shop-price.mp3"
  },
  {
