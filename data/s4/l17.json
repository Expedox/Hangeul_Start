  {
   "id": "s4-d-rest-how-many",
   "hangul": "몇 분이세요?",
   "type": "dialog",
   "topic": "restaurant",
   "sound": {
    "de": "myeot buniseyo?",
    "en": "myeot buniseyo?"
   },
   "meaning": {
    "de": "Wie viele Personen?",
    "en": "How many people?"
   },
   "reply": {
    "hangul": "두 명이에요",
    "sound": {
     "de": "du myeongieyo",
     "en": "du myeongieyo"
    },
    "meaning": {
     "de": "Zwei Personen.",
     "en": "Two people."
    }
   },
   "wrongReplies": [
    {
     "hangul": "김밥이 싸요",
     "meaning": {
      "de": "Kimbap ist billig.",
      "en": "Kimbap is cheap."
     }
    },
    {
     "hangul": "저는 의사예요",
     "meaning": {
      "de": "Ich bin Arzt / Ärztin.",
      "en": "I'm a doctor."
     }
    },
    {
     "hangul": "화장실이 없어요",
     "meaning": {
      "de": "Es gibt keine Toilette.",
      "en": "There's no toilet."
     }
    }
   ],
   "note": {
    "de": "분 ist das ehrende Zählwort für Personen. Du selbst sagst 명.",
    "en": "분 is the honorific counter for people. You say 명 yourself."
   },
   "audio": "audio/s4-d-rest-how-many.mp3"
  },
