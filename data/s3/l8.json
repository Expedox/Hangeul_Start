 "title": {
  "de": "Ja, nein und Verstehen",
  "en": "Yes, no and understanding"
 },
 "intro": {
  "de": "Kleine Sätze, die dir im Gespräch helfen, wenn du etwas nicht verstehst.\n네 heißt „ja“, kann aber auch einfach „ich höre zu“ bedeuten.",
  "en": "Short phrases that help when you don't understand something.\n네 means \"yes\", but it can also just mean \"I'm listening\"."
 },
 "exercises": [
  "see-meaning",
  "pick-hangul",
  "hear-meaning",
  "see-sound"
 ],
