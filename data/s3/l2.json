 "stage": 3,
 "lesson": 2,
 "title": {
  "de": "Größere Zahlen",
  "en": "Bigger numbers"
 },
 "intro": {
  "de": "Größere Zahlen setzt du wie Bausteine zusammen: Zehner zuerst, dann die Einer.\n십일 = 10 + 1 = 11, 이십 = 2 × 10 = 20, 이십삼 = 23.\nBei 100, 1000 und 10.000 sagt man kein 일 davor: 백, 천, 만. Wichtig: Koreanisch zählt in Zehntausendern (만), nicht in Tausendern.",
  "en": "You build bigger numbers like blocks: tens first, then ones.\n십일 = 10 + 1 = 11, 이십 = 2 × 10 = 20, 이십삼 = 23.\nFor 100, 1,000 and 10,000 you drop the 일: just 백, 천, 만. Note that Korean groups large numbers by ten thousands (만), not thousands."
 },
 "exercises": [
  "see-meaning",
  "pick-hangul",
  "hear-meaning",
  "see-sound"
 ],
