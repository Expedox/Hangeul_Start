 "stage": 3,
 "lesson": 16,
 "title": {
  "de": "Wochentage und Monate",
  "en": "Days and months"
 },
 "intro": {
  "de": "Alle Wochentage enden auf 요일. Die Monate sind einfach: sino-koreanische Zahl + 월. Nur zwei weichen ab: 유월 (Juni) und 시월 (Oktober).",
  "en": "All weekdays end in 요일. Months are easy: Sino-Korean number + 월. Only two are irregular: 유월 (June) and 시월 (October)."
 },
 "exercises": [
  "see-meaning",
  "pick-hangul",
  "hear-meaning",
  "see-sound"
 ],
