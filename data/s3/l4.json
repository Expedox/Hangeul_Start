 "stage": 3,
 "lesson": 4,
 "title": {
  "de": "Uhrzeit",
  "en": "Telling the time"
 },
 "intro": {
  "de": "Bei der Uhrzeit mischt Koreanisch beide Zahlenreihen: Die Stunde ist rein koreanisch (한 시, 세 시), die Minuten sind sino-koreanisch (십 분).\n„Halb“ (반) kommt nach der Stunde: 세 시 반 = 3:30.",
  "en": "Korean mixes both number sets for time: hours use native numbers (한 시, 세 시), minutes use Sino-Korean ones (십 분).\n\"Half\" (반) comes after the hour: 세 시 반 = 3:30."
 },
 "exercises": [
  "see-meaning",
  "pick-hangul",
  "hear-meaning",
  "see-sound"
 ],
