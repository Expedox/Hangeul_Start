 "title": {
  "de": "Preise",
  "en": "Prices"
 },
 "intro": {
  "de": "Preise nennst du mit sino-koreanischen Zahlen und 원 (Won).\nDa 원 mit einem Vokal beginnt, verbindet sich der Endkonsonant davor: 천 원 klingt wie [처눤].",
  "en": "Prices use Sino-Korean numbers plus 원 (won).\nBecause 원 starts with a vowel, the final consonant before it links over: 천 원 sounds like [처눤]."
 },
 "exercises": [
  "see-meaning",
  "pick-hangul",
  "hear-meaning",
  "see-sound"
 ],
