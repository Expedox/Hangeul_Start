 "lesson": 10,
 "title": {
  "de": "Familie",
  "en": "Family"
 },
 "intro": {
  "de": "Bei Geschwistern hängt das Wort davon ab, wer spricht: Ein Mann nennt seinen älteren Bruder 형, eine Frau sagt 오빠. Die ältere Schwester einer Frau ist 언니 (die eines Mannes 누나, kennst du schon).",
  "en": "For siblings, the word depends on who is speaking: a man calls his older brother 형, a woman says 오빠. A woman's older sister is 언니 (a man's is 누나, which you already know)."
 },
 "exercises": [
  "see-meaning",
  "pick-hangul",
  "hear-meaning",
  "see-sound"
 ],
