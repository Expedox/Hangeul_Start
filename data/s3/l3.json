 "title": {
  "de": "Zahlen 1 bis 10 (rein koreanisch)",
  "en": "Numbers 1 to 10 (native Korean)"
 },
 "intro": {
  "de": "Mit diesen Zahlen zählst du Dinge und Personen, sagst dein Alter und die Stunde bei der Uhrzeit.\nVor einem Zählwort werden einige kürzer: 하나 → 한, 둘 → 두, 셋 → 세, 넷 → 네. Also 한 시 (ein Uhr), 두 개 (zwei Stück).",
  "en": "Use these numbers to count things and people, to say your age and the hour on the clock.\nSome get shorter before a counter word: 하나 → 한, 둘 → 두, 셋 → 세, 넷 → 네. So 한 시 (one o'clock), 두 개 (two pieces)."
 },
 "exercises": [
  "see-meaning",
  "pick-hangul",
  "hear-meaning",
  "see-sound"
 ],
